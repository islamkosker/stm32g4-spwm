{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/Debug",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {}
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/Release",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Test",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/build-test",
      "toolchainFile": "${sourceDir}/cmake/gcc-test.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Test",
        "BUILD_APP": "OFF",
        "BUILD_TEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Test",
      "configurePreset": "Test"
    }
  ],
  "testPresets": [
    {
      "name": "tester",
      "configurePreset": "Test",
      "output": {
        "verbosity": "verbose"
      }
    }
  ]
}